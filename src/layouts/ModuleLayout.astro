---
// Página de módulo: topo "SDLabs", título, barra fixa de progresso com índice e o modo foco
// (src/scripts/focus-mode.js). As aulas (<Lesson>) entram no slot, dentro de <main class="sdl-content">.
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/url.js';
import '../styles/lesson.css';
import '../styles/module.css';
import '../styles/widgets.css';
import '../styles/glossary.css';
import Glossary from '../components/Glossary.astro';
import { glossaries } from '../data/glossary.js';
import { glossariesEn } from '../data/glossary.en.js';
import { t as tr, langOf, otherLangPath, hasEn } from '../lib/i18n.js';

interface LessonRef { id: string; title: string }
interface Props {
  title: string;          // <title> da página
  description: string;
  module: string;         // slug do módulo: chave do localStorage (sdl-<module>:...)
  heading: string;        // h1 e nome na barra fixa
  lead: string;           // frase abaixo do h1
  lessons: LessonRef[];   // na ordem, para o índice
  quizHref?: string;      // link do quiz no painel (opcional)
  terms?: typeof glossaries[string]; // glossário próprio (a página do sistema de design usa)
}
const { title, description, module, heading, lead, lessons, quizHref } = Astro.props;
const T = tr(Astro.url), en = langOf(Astro.url) === 'en';
const terms = Astro.props.terms ?? (en ? glossariesEn : glossaries)[module] ?? [];
const label = `${heading} · ${T.topics(lessons.length)}`;
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <slot name="head" />
    <!-- números de destaque dos widgets em 7 segmentos (public/shared/readouts.js) -->
    <script is:inline defer src={withBase('shared/readouts.js')}></script>
    <!-- módulos são deferidos: no head rodam antes do script da figura, como no site antigo -->
    <script>
      import '../scripts/focus-mode.js';
      import '../scripts/glossary.js';
    </script>
  </Fragment>
  <div class="sdl-top"><a class="sdl-brand" href={withBase(en ? 'en/' : '')} aria-label={T.brandAria}>SDLabs</a><span class="label">{T.lessons(lessons.length)}<span class="sdl-top-more">{terms.length > 0 && ` · ${T.glossaryLower}`}{quizHref && ' · quiz'}</span></span>{(en || hasEn(module)) && <a class="sdl-lang" href={otherLangPath(Astro.url)} hreflang={en ? 'pt-BR' : 'en'} aria-label={T.switchAria}>{T.switchTo}</a>}</div>
  <header class="sdl-hero">
    <h1>{heading}</h1>
    <div class="sdl-lead"><p id="sdl-lead">{lead}</p><button type="button" class="sdl-lead-more" aria-expanded="false" aria-controls="sdl-lead" data-more={T.more} data-less={T.less} hidden><span>{T.more}</span><i class="ico ico-down" aria-hidden="true"></i></button></div>
  </header>
  <script is:inline>
    // celular: a descrição fica numa linha; "mais" abre o resto. Sem JS ela aparece inteira.
    (function () {
      var hero = document.currentScript.previousElementSibling, p = document.getElementById('sdl-lead'), b = p && p.nextElementSibling;
      if (!b) return;
      hero.classList.add('clamp');
      function fit() { if (b.getAttribute('aria-expanded') !== 'true') b.hidden = p.scrollHeight <= p.clientHeight + 1; }
      fit(); addEventListener('resize', fit);
      var still = matchMedia('(prefers-reduced-motion: reduce)').matches, anim = null;
      b.addEventListener('click', function () {
        var open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(open)); b.firstChild.textContent = open ? b.dataset.less : b.dataset.more;
        if (anim) { anim.cancel(); anim = null; }
        // a altura da descrição anima (texto de poucas linhas, uma vez por toque); fechar mantém o texto inteiro até recolher
        var ease = 'cubic-bezier(.16,1,.3,1)';
        if (still) { p.classList.toggle('open', open); return; }
        if (open) {
          var h0 = p.offsetHeight; p.classList.add('open'); var h1 = p.offsetHeight;
          anim = p.animate({ height: [h0 + 'px', h1 + 'px'], overflow: ['hidden', 'hidden'] }, { duration: 320, easing: ease });
        } else {
          var h1c = p.offsetHeight; p.classList.remove('open'); var h0c = p.offsetHeight; p.classList.add('open');
          var a = anim = p.animate({ height: [h1c + 'px', h0c + 'px'], overflow: ['hidden', 'hidden'] }, { duration: 260, easing: ease, fill: 'forwards' });
          a.onfinish = function () { p.classList.remove('open'); a.cancel(); anim = null; };
        }
      });
    })();
  </script>
  <main class="sdl-content" data-module={module}>
    <div class="sdl-progress">
      <div class="pg-row">
        <button type="button" class="pg-step" data-pg="prev" aria-label={T.prevLesson}></button>
        <button type="button" class="pg-status" aria-expanded="false" aria-controls="sdl-panel"><span class="pg-text">{label}</span><span class="pg-caret" aria-hidden="true"></span></button>
        <button type="button" class="pg-step" data-pg="next" aria-label={T.nextLesson}></button>
        {quizHref && <a class="pg-quizbtn" href={quizHref} aria-label={T.quizAria}>{T.quiz}</a>}
      </div>
      <div class="pg-meter">
        <div class="pg-track" role="progressbar" aria-label={T.progress} aria-valuemin="0" aria-valuemax={lessons.length} aria-valuenow="0"></div>
        <span class="pg-count">0/{lessons.length}</span>
      </div>
      <div class="pg-panel" id="sdl-panel">
        {quizHref && <a class="btn big primary pg-quiz" href={quizHref}>{T.quizCta}<i class="ico ico-next" aria-hidden="true"></i></a>}
        <button type="button" class="pg-switch" role="switch" aria-checked="false"><span>{T.onePage}</span><i aria-hidden="true"></i></button>
        {terms.length > 0 && <button type="button" class="pg-glossary" data-gl-open>{T.glossary} ({T.terms(terms.length)}) <i class="ico ico-down" aria-hidden="true"></i></button>}
        <nav class="toc" aria-label={T.toc}>
          <p class="toc-title label">{label}</p>
          <ol>
            {lessons.map((l, i) => <li><a href={`#${l.id}`}><span>{i + 1}</span> {l.title}</a></li>)}
          </ol>
        </nav>
      </div>
    </div>
    <noscript><style is:inline>.sdl-content .fc-a[hidden]{display:block}</style></noscript>
    <slot />
    {terms.length > 0 && <Glossary terms={terms} lessons={lessons} />}
  </main>
  <footer class="sdl-credit" set:html={T.credit}></footer>
</BaseLayout>
