---
// Asynchronous Communication module (English): the 10 lessons in src/content/_en/comunicacao-assincrona/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/comunicacao-assincrona.css';

const entries = (await getCollection('en-comunicacao-assincrona')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/comunicacao-assincrona/quiz/');
---
<ModuleLayout
  title="Asynchronous Communication: Messaging, Events and Streaming · SDLabs"
  description="Messages, commands, events and documents, queues, DLQ, streaming, Kafka (topics, partitions, groups and replication), MQTT and AMQP with RabbitMQ, with widgets and a quiz."
  module="comunicacao-assincrona"
  heading="Asynchronous Communication: Messaging, Events and Streaming"
  lead="Lena's payment has to notify inventory, shipping and notifications. How to notify without waiting, without losing the notice and without the producer knowing who listens, and which protocol fits each leg: Kafka, MQTT or AMQP."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/comunicacao-assincrona/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
