---
// Backend for Frontends (BFF) module (English): the 8 lessons in src/content/_en/bff/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/bff.css';

const entries = (await getCollection('en-bff')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/bff/quiz/');
---
<ModuleLayout
  title="Backend for Frontends (BFF) · SDLabs"
  description="Backend for Frontends: a backend tailored to each frontend, with API composition, channels, microfrontends, versions, timeout and fallback, and metrics per channel."
  module="bff"
  heading="Backend for Frontends (BFF)"
  lead="Lena's app makes four calls to build one screen and receives JSON made for the website. How the store puts a tailored backend between each frontend and the services, and what changes when something goes down."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/bff/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
