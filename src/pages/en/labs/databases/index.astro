---
// Databases, Data Models and Indexing module (English): the 15 lessons in src/content/_en/databases/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/databases.css';

const entries = (await getCollection('en-databases')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/databases/quiz/');
---
<ModuleLayout
  title="Databases, Data Models and Indexing · SDLabs"
  description="Databases, data models and indexing: database types, consistency, row, document, column and graph models, pages, LSM-Tree, B-Tree, hash and inverted index, with interactive labs."
  module="databases"
  heading="Databases, Data Models and Indexing"
  lead="How Lena's order 1042 is stored, and how many pages the disk reads to find it. The same store, from start to finish."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/databases/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
