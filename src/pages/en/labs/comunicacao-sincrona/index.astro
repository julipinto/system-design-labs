---
// Synchronous Communication module (English): the 8 lessons in src/content/_en/comunicacao-sincrona/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/comunicacao-sincrona.css';

const entries = (await getCollection('en-comunicacao-sincrona')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/comunicacao-sincrona/quiz/');
---
<ModuleLayout
  title="Synchronous Communication · SDLabs"
  description="REST, webhooks, short and long polling, RPC, gRPC and Protobuf, WebSocket and GraphQL: when one service calls another and waits, in what format, over which protocol and how the other side calls back, with real bytes, calculators and a quiz."
  module="comunicacao-sincrona"
  heading="Synchronous Communication"
  lead="Davi wants the blue mug and pays with Pix at a third-party PSP. The pedidos calls the pagamentos, which calls the PSP, and Davi's screen needs to know when the money arrived. In what format and over which protocol a call waits, and how the other side calls back."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/comunicacao-sincrona/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
