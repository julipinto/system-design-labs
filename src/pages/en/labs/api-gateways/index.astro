---
// API Gateways module (English): the 7 lessons in src/content/_en/api-gateways/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/api-gateways.css';

const entries = (await getCollection('en-api-gateways')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/api-gateways/quiz/');
---
<ModuleLayout
  title="API Gateways · SDLabs"
  description="API Gateways: single entry point, gateway vs load balancer, routing, JWT, authentication and authorization, rate limiting with token bucket and leaky bucket, throttling, versioning and canary, with Kong read line by line."
  module="api-gateways"
  heading="API Gateways"
  lead="The store opened a mobile app and an API for partners, and a bot asks for the cat's price 500 times per second. How a single door applies the common rules once: where each call goes, who can do what, how much each client can ask for and which version of the API it uses."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/api-gateways/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
