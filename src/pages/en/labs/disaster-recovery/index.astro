---
// Single Point of Failure and Disaster Recovery module (English): the 5 lessons in src/content/_en/disaster-recovery/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/disaster-recovery.css';

const entries = (await getCollection('en-disaster-recovery')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/disaster-recovery/quiz/');
---
<ModuleLayout
  title="Single Point of Failure and Disaster Recovery · SDLabs"
  description="The São Paulo region disappears at 20:40 on Black Friday: what a single point of failure is, how to find the ones nobody sees, active and passive redundancy, failover and split brain, Disaster Recovery strategies and the MTTD, MTTR, MTBF, RTO and RPO metrics, with the store's numbers, widgets and a quiz."
  module="disaster-recovery"
  heading="Single Point of Failure and Disaster Recovery"
  lead={'Module 26 left the store in four cells, and a question hanging: what if it is not one cell that falls, but the whole São Paulo region? What a single point of failure is, how to find the ones nobody sees, how to duplicate without paying for what you do not need, what to do in a disaster and how to measure whether recovery is getting better.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/disaster-recovery/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
