---
// Scale Cube module (English): the 6 lessons in src/content/_en/scale-cube/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/scale-cube.css';

const entries = (await getCollection('en-scale-cube')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/scale-cube/quiz/');
---
<ModuleLayout
  title="Scale Cube · SDLabs"
  description="The three-axis map for growing: X (clone), Y (split by function) and Z (split by data), with the store in coordinates, diagnosis by symptom, pod math and the Z router, with widgets and a quiz."
  module="scale-cube"
  heading="Scale Cube"
  lead="Every bottleneck we solved on Black Friday moved somewhere else, and the pedidos database stopped at 150 orders per second. Which axis to attack for each symptom, in what order and what each one costs: clone, split by function or split by data."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/scale-cube/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
