---
// Concurrency and Parallelism module (English): the 10 lessons in src/content/_en/concorrencia/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/concorrencia.css';

const entries = (await getCollection('en-concorrencia')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/concorrencia/quiz/');
---
<ModuleLayout
  title="Concurrency and Parallelism · SDLabs"
  description="Processes, threads and goroutines, concurrency and parallelism, race conditions, deadlock, mutex, distributed lock, spinlock and semaphore, with interactive labs."
  module="concorrencia"
  heading="Concurrency and Parallelism"
  lead="1 plush cat left, and Bia and Caio click buy 2 ms apart. How many things happen at the same time without stepping on each other, inside a process and across replicas."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/concorrencia/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
