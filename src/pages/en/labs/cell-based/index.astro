---
// Cell-Based Architecture module (English): the 4 lessons in src/content/_en/cell-based/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/cell-based.css';

const entries = (await getCollection('en-cell-based')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/cell-based/quiz/');
---
<ModuleLayout
  title="Cell-Based Architecture · SDLabs"
  description="Can one poisoned order take down the whole store? The stack split into four cells: the uneven radius, the structure and the cost of the floor, the router and the map, the passive cell, 2PC and shuffle sharding, with the store's numbers, widgets and a quiz."
  module="cell-based"
  heading="Cell-Based Architecture"
  lead={'At 20:25 on Black Friday an order with quantity 2147483648 takes down the 3 pedidos pods, and the whole store is out for 4 minutes. How to split the stack into cells that share nothing: what each one holds, what it costs, how Lena\'s order finds hers and what to do when one goes down.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/cell-based/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
