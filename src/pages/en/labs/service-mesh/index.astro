---
// Service Mesh module (English): the 6 lessons in src/content/_en/service-mesh/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/service-mesh.css';

const entries = (await getCollection('en-service-mesh')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/service-mesh/quiz/');
---
<ModuleLayout
  title="Service Mesh · SDLabs"
  description="Service mesh: retry, timeout, mTLS, authorization and telemetry in the network instead of the code, control plane and data plane, sidecar, proxyless, eBPF and ambient, with interactive labs."
  module="service-mesh"
  heading="Service Mesh"
  lead="Inside the store, 6 services in 3 languages call each other all the time, and each team wrote retry, timeout, TLS and metrics its own way. How to take that out of the code, put it in the network once, and know when a mesh pays off."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/service-mesh/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
