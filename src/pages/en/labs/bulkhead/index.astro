---
// Bulkhead Pattern module (English): the 5 lessons in src/content/_en/bulkhead/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/bulkhead.css';

const entries = (await getCollection('en-bulkhead')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/bulkhead/quiz/');
---
<ModuleLayout
  title="Bulkhead Pattern · SDLabs"
  description="Splitting finite resources into compartments so a hole floods only one: the orders 20-connection pool and the 23:00 report, logical and physical bulkheads, blast radius, functional and operational sharding and the six reference designs, with the real k6, widgets and quiz."
  module="bulkhead"
  heading="Bulkhead Pattern"
  lead={'The 23:00 report and Lena\'s order share a pool of 20 database connections, and 1 in 3 checkout orders gets a 503. How to split threads, connections, queues and nodes into compartments so one bad part floods only its own, and what that costs.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/bulkhead/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
