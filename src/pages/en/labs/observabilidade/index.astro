---
// Observability and Monitoring module (English): the 10 lessons in src/content/_en/observabilidade/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/observabilidade.css';

const entries = (await getCollection('en-observabilidade')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/observabilidade/quiz/');
---
<ModuleLayout
  title="Observability and Monitoring · SDLabs"
  description="Seeing what the store is doing, order by order: reliability, monitoring and observability, metrics, logs and traces of order 1063, alerts and APM, SLI, SLO, SLA and error budget, and the USE and RED methods and the four golden signals, with the math worked out, widgets and a quiz."
  module="observabilidade"
  heading="Observability and Monitoring"
  lead={'Lena waited 1.9 s and the dashboard was green. How to see what happens inside the store, order by order: reliability, the three signals, when to wake someone up, how much error is acceptable and three shortcuts (USE, RED and the four signals) to know where to look.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/observabilidade/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
