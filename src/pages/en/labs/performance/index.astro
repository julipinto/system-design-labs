---
// Performance, Capacity and Scalability module (English): the 6 lessons in src/content/_en/performance/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/performance.css';

const entries = (await getCollection('en-performance')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/performance/quiz/');
---
<ModuleLayout
  title="Performance, Capacity and Scalability · SDLabs"
  description="Measure (response time, four signals, percentiles), limit (capacity, the knee of the curve, bottleneck) and grow (vertical, horizontal and the HPA formula), with the store's Black Friday numbers, widgets and a quiz."
  module="performance"
  heading="Performance, Capacity and Scalability"
  lead="Black Friday showed a catalog that answered in 2 s for some customers, and nobody knew how much the store can take. How to measure properly, find the limit of each link and decide how much to add and when."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/performance/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
