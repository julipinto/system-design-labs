---
// Storage, RAID and I/O module (English): the 13 lessons in src/content/_en/storage-raid-io/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/storage-raid-io.css';

const entries = (await getCollection('en-storage-raid-io')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/storage-raid-io/quiz/');
---
<ModuleLayout
  title="Storage, RAID and I/O · SDLabs"
  description="Storage, RAID and I/O: IOPS and throughput, DAS, NAS, block, file and object storage, RAID 0, 1, 5, 6 and 10, with interactive labs."
  module="storage-raid-io"
  heading="Storage, RAID and I/O"
  lead="Where data lives, how fast it is, and what happens when a disk dies. An online store from start to finish."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/storage-raid-io/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
