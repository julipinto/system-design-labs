---
// Data Replication module (English): the 6 lessons in src/content/_en/replicacao/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/replicacao.css';

const entries = (await getCollection('en-replicacao')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/replicacao/quiz/');
---
<ModuleLayout
  title="Data Replication · SDLabs"
  description="Copying the same data to SP, Rio and Recife: Primary/Replica and Primary/Primary models, synchronous, asynchronous and semi-synchronous replication, Event-Carried State Transfer, CDC with Debezium and CRDTs, with the store's Black Friday numbers, widgets and a quiz."
  module="replicacao"
  heading="Data Replication"
  lead="Each shard in the store is a single server. How to keep the same data in SP, Rio and Recife without Lena seeing the past, without losing orders when the primary goes down and without two owners fighting over the same data."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/replicacao/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
