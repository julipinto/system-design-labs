---
// Load and Stress Testing module (English): the 11 lessons in src/content/_en/testes-de-carga/, in `order` field order.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Lesson from '../../../../components/Lesson.astro';
import { withBase } from '../../../../lib/url.js';
import '../../../../styles/testes-de-carga.css';

const entries = (await getCollection('en-testes-de-carga')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('en/labs/testes-de-carga/quiz/');
---
<ModuleLayout
  title="Load and Stress Testing · SDLabs"
  description="Refuting the Black Friday plan with a test: load vs. stress, smoke, average load, stress, spike and breakpoint with k6 against a checkout simulator, open vs. closed model, targets and percentiles, pre-test and report, with the measured numbers, widgets and quiz."
  module="testes-de-carga"
  heading="Load and Stress Testing"
  lead={'Module 23\'s plan says the checkout handles 300 orders per second, and nobody measured it. How to refute that math with a test, without knocking over production: which question to ask, how to inject the load without fooling yourself, where the breaking point is and what the test still doesn\'t show.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../../scripts/testes-de-carga/widgets.en.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Test what you learned: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
