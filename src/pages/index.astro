---
// Home: lista os módulos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url.js';
---
<BaseLayout title="SDLabs" description="Laboratórios visuais e interativos de System Design.">
<style is:global>
main{max-width:960px;margin:0 auto;padding:56px 16px 80px}
h1{margin:0 0 10px;font-size:clamp(36px,9vw,60px);line-height:1;letter-spacing:-.03em}
.lead{margin:0 0 40px;max-width:600px;color:var(--muted);font-size:18px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.card{display:block;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;color:var(--fg);text-decoration:none;transition:border-color .2s}
a.card:hover,a.card:focus-visible{border-color:var(--accent);outline:none}
.card .n{font:600 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.card h2{margin:8px 0 6px;font-size:21px;line-height:1.2}
.card p{margin:0;color:var(--muted);font-size:14px}
.card.soon{opacity:.55}
.card.soon .n{color:var(--muted)}
footer{margin-top:48px;font:12px var(--mono);color:var(--faint)}
</style>
<main>
  <h1>SDLabs</h1>
  <p class="lead">Laboratórios de System Design para mexer e não esquecer mais.</p>
  <div class="grid">
    <a class="card" href={withBase('labs/protocolos-de-rede/')}>
      <span class="n">Módulo · 9 aulas</span>
      <h2>Protocolos de Rede</h2>
      <p>OSI numa figura interativa, IP, TCP e UDP, TLS, DNS, DHCP, HTTP/1.1 a HTTP/3 e tempo de resposta.</p>
    </a>
    <a class="card" href={withBase('labs/protocolos-de-rede/quiz/')}>
      <span class="n">Quiz · 76 perguntas</span>
      <h2>Quiz de Protocolos de Rede</h2>
      <p>Rodadas curtas por tópico, resposta na hora com explicação e "revisar só as que errei".</p>
    </a>
    <div class="card soon" aria-disabled="true">
      <span class="n">Próximo módulo</span>
      <h2>Em breve</h2>
      <p>O próximo módulo entra aqui.</p>
    </div>
  </div>
  <footer>Notas pessoais de estudo, escritas com minhas palavras. Fonte: artigos públicos de Matheus Fidelis em <a href="https://fidelissauro.dev">fidelissauro.dev</a>. Sem vínculo com o autor ou com qualquer curso.</footer>
</main>
</BaseLayout>
