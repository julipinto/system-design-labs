---
// Home: índice dos módulos, um por linha, na ordem da história (cada módulo é o próximo problema da loja).
// O progresso de cada linha vem do localStorage que o modo foco grava (sdl-<módulo>:done).
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url.js';
import '../styles/home.css';

interface Mod { n?: number; slug?: string; title: string; lessons?: number; text: string; poster?: string; alt?: string }
const modules: Mod[] = [
  { slug: 'protocolos-de-rede', title: 'Protocolos de Rede', lessons: 9, poster: 'labs/protocolos-de-rede/osi-3d-previa.webp', alt: 'Prévia da figura 3D do modelo OSI',
    text: 'OSI e HTTP em figuras 3D, IP, TCP e UDP, TLS, DNS, DHCP e tempo de resposta. Com quiz de 80 perguntas.' },
  { slug: 'storage-raid-io', title: 'Storage, RAID e I/O', lessons: 13, poster: 'labs/storage-raid-io/raid-3d-previa.webp', alt: 'Prévia da figura 3D de RAID',
    text: 'IOPS e throughput, DAS, NAS, block, file e object storage, e RAID 0, 1, 5, 6 e 10 em figuras 3D. Com calculadoras e quiz de 66 perguntas.' },
  { slug: 'cap-acid-base', title: 'Teorema CAP, ACID e BASE', lessons: 7, poster: 'labs/cap-acid-base/cap-3d-previa.webp', alt: 'Prévia da figura 3D do teorema CAP',
    text: 'Consistência, disponibilidade e partição, transações ACID, consistência eventual e PACELC, com um simulador de níveis de isolamento. Com quiz de 52 perguntas.' },
  { slug: 'databases', title: 'Databases, Modelos de Dados e Indexação', lessons: 15, poster: 'labs/databases/indices-3d-previa.webp', alt: 'Prévia da figura 3D de índices',
    text: 'Tipos de banco, níveis de consistência, os seis modelos de dados, páginas, LSM-Tree, B-Tree, hash e índice invertido, com calculadoras e simuladores. Com quiz de 61 perguntas.' },
  { slug: 'cache', title: 'Estratégias de Cache', lessons: 7, poster: 'labs/cache/cache-3d-previa.webp', alt: 'Prévia da figura 3D de cache',
    text: 'Hit e miss, TTL, evicção (LRU, LFU e FIFO), hit rate, hashmap e Redis, cache-aside, write-through, write-behind e CDN, com um proxy em Go lido linha a linha. Com quiz de 46 perguntas.' },
  { slug: 'microsservicos', title: 'Microsserviços, Monolitos e Domínios', lessons: 8, poster: 'labs/microsservicos/monolito-3d-previa.webp', alt: 'Prévia da figura 3D do monolito',
    text: 'Quando e como partir o programa da loja: monolito, microsserviços, DDD (contextos, agregados, eventos), Lei de Conway e um case com o pedido 1047, com calculadoras e simuladores. Com quiz de 51 perguntas.' },
  { slug: 'load-balancers', title: 'Load Balancers e Proxies Reversos', lessons: 10, poster: 'labs/load-balancers/balanceador-3d-previa.webp', alt: 'Prévia da figura 3D do balanceador de carga',
    text: 'Healthcheck, proxy reverso, round robin, least request, least connection, LOR, IP hash, Maglev e random, camadas 4 e 7, e um laboratório com Envoy lido linha a linha. Com quiz de 56 perguntas.' },
  { slug: 'api-gateways', title: 'API Gateways', lessons: 7, poster: 'labs/api-gateways/gateway-3d-previa.webp', alt: 'Prévia da figura 3D do API Gateway',
    text: 'A porta única da loja: roteamento por método e caminho, JWT, escopos, rate limiting com token bucket e leaky bucket, throttling, versionamento e canary, com o Kong lido linha a linha. Com quiz de 43 perguntas.' },
  { slug: 'bff', title: 'Backend for Frontends (BFF)', lessons: 8, poster: 'labs/bff/bff-3d-previa.webp', alt: 'Prévia da figura 3D do BFF',
    text: 'Um backend sob medida para cada frontend: API composition, canais (app, site e voz), microfrontends, versões, timeout e fallback, e métricas por canal. Com quiz de 46 perguntas.' },
  { slug: 'service-mesh', title: 'Service Mesh', lessons: 6, poster: 'labs/service-mesh/mesh-3d-previa.webp', alt: 'Prévia da figura 3D de service mesh',
    text: 'Retry, timeout, mTLS e métricas tirados do código e postos na rede: control plane e data plane, sidecar, proxyless, eBPF e ambient (ztunnel e waypoint), com calculadoras e quiz de 35 perguntas.' },
  { slug: 'concorrencia', title: 'Concorrência e Paralelismo', lessons: 10, poster: 'labs/concorrencia/estoque-3d-previa.webp', alt: 'Prévia da figura 3D do estoque com o último gato',
    text: 'Processos, threads e goroutines, concorrência contra paralelismo, a corrida pelo último gato, deadlock, mutex, lock distribuído no Redis, spinlock, semáforo e pool de conexões, com widgets e quiz de 62 perguntas.' },
  { slug: 'comunicacao-sincrona', title: 'Comunicação Síncrona', lessons: 8, poster: 'labs/comunicacao-sincrona/chamada-3d-previa.webp', alt: 'Prévia da figura 3D da chamada entre serviços',
    text: 'Chamar e esperar a resposta: REST, webhooks, short e long polling, RPC, gRPC com Protobuf, WebSocket e GraphQL, com os bytes reais da cobrança do Davi, calculadoras e quiz de 51 perguntas.' },
  { slug: 'comunicacao-assincrona', title: 'Comunicação Assíncrona: Mensageria, Eventos e Streaming', lessons: 10, poster: 'labs/comunicacao-assincrona/kafka-3d-previa.webp', alt: 'Prévia da figura 3D do Kafka',
    text: 'Mensagens, comandos e eventos, filas e DLQ, streaming, Kafka com partições, grupos e replicação, MQTT para o caminhão e AMQP no RabbitMQ para os e-mails, com widgets e quiz de 63 perguntas.' },
  { slug: 'performance', title: 'Performance, Capacidade e Escalabilidade', lessons: 6, poster: 'labs/performance/latencia-3d-previa.webp', alt: 'Prévia da figura 3D da frota de réplicas e dos 100 pedidos',
    text: 'A Black Friday em números: tempo de resposta, quatro sinais e percentis, capacidade e gargalo, escalabilidade vertical e horizontal e a fórmula do HPA, com calculadoras e quiz de 41 perguntas.' },
  { slug: 'scale-cube', title: 'Scale Cube', lessons: 6, poster: 'labs/scale-cube/cubo-3d-previa.webp', alt: 'Prévia da figura 3D do cubo da escalabilidade',
    text: 'Três perguntas para decidir por onde crescer: clonar (X), separar por função (Y) ou separar por dados (Z). A loja em coordenadas, a tabela de sintomas, o roteador do Z e a conta de pods, com widgets e quiz de 37 perguntas.' },
  { slug: 'sharding', title: 'Sharding e Particionamento', lessons: 10, poster: 'labs/sharding/shards-3d-previa.webp', alt: 'Prévia da figura 3D da tabela pedidos partida em shards',
    text: 'Partir a tabela pedidos de 50 milhões de linhas: chave de sharding e shard quente, partições do PostgreSQL, ranges, hash, hashing consistente, slots, diretório e shuffle sharding, com os labs do autor lidos linha a linha. Com widgets e quiz de 57 perguntas.' },
  { slug: 'replicacao', title: 'Replicação de Dados', lessons: 6, poster: 'labs/replicacao/replicas-3d-previa.webp', alt: 'Prévia da figura 3D dos três sites com a fita do log',
    text: 'O mesmo dado em SP, no Rio e em Recife: Primary/Replica e Primary/Primary, síncrona, assíncrona e semi-síncrona, a Lena sem ver o próprio pedido, ECST, CDC com Debezium e CRDTs, com calculadoras e quiz de 41 perguntas.' },
  { slug: 'cqrs', title: 'CQRS', lessons: 10, poster: 'labs/cqrs/cqrs-3d-previa.webp', alt: 'Prévia da figura 3D dos dois modelos, o de comando e o de consulta',
    text: 'Um modelo para escrever e outro para ler: comandos e consultas, view materializada, réplicas de leitura, consistência eventual, SQL e NoSQL, modelos que juntam serviços, escrita dupla, CDC e outbox, com calculadoras e quiz de 50 perguntas.' },
  { n: 21, slug: 'resiliencia', title: 'Patterns de Resiliência', lessons: 13, poster: 'labs/resiliencia/chamadas-3d-previa.webp', alt: 'Prévia da figura 3D da chamada que atravessa a loja até o PSP',
    text: 'Continuar vendendo quando o PSP responde em 8 s: disponibilidade e orçamento de erro, blast radius, healthchecks, idempotência, timeouts, retry com backoff e jitter, circuit breaker, fallback, degradação, backpressure, camada de dados e bulkheads, com calculadoras e quiz de 72 perguntas.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="SDLabs" description="Laboratórios visuais e interativos de System Design.">
<main class="home">
  <header class="home-head">
    <h1><i class="lit" aria-hidden="true"></i>SDLabs</h1>
    <p class="lead">Laboratórios de System Design para mexer e não esquecer mais.</p>
    <p class="story">A mesma história do começo ao fim: a Lena, de Recife, compra um gato de pelúcia na loja, e cada módulo é o próximo problema que essa loja enfrenta ao crescer.</p>
  </header>
  <ol class="mods">
    {modules.map((m, i) => m.slug ? (
      <li class="mod" data-mod={m.slug} data-total={m.lessons}>
        <a class="mod-link" href={withBase(`labs/${m.slug}/`)}>
          <span class="mod-n" aria-hidden="true">{pad(m.n ?? i + 1)}</span>
          <div class="mod-body">
            <h2>{m.title}</h2>
            <p>{m.text}</p>
            <div class="mod-meta">
              <span class="label">{m.lessons} aulas</span>
              <span class="label mod-prog" hidden><span class="mod-bar" aria-hidden="true"></span><span class="mod-prog-t"></span></span>
            </div>
          </div>
          <div class="mod-fig" aria-hidden="true"><img src={withBase(m.poster!)} alt="" width="640" height="560" loading="lazy" /></div>
        </a>
      </li>
    ) : (
      <li class="mod soon" aria-disabled="true">
        <div class="mod-link">
          <span class="mod-n" aria-hidden="true">{pad(m.n ?? i + 1)}</span>
          <div class="mod-body"><h2>{m.title}</h2><p>{m.text}</p></div>
        </div>
      </li>
    ))}
  </ol>
  <footer class="home-foot">
    <p>Notas pessoais de estudo, escritas com minhas palavras. Fonte: artigos públicos de Matheus Fidelis em <a href="https://fidelissauro.dev">fidelissauro.dev</a>. Sem vínculo com o autor ou com qualquer curso.</p>
    <p><a href={withBase('sistema-de-design/')}>Sistema de design do site</a></p>
  </footer>
</main>
<script is:inline>
  // progresso salvo pelo modo foco de cada módulo: "3 de 9 entendidas" + a régua
  document.querySelectorAll('.mod[data-mod]').forEach(function (li) {
    var n = 0, total = +li.dataset.total;
    try { n = (JSON.parse(localStorage.getItem('sdl-' + li.dataset.mod + ':done') || '[]') || []).length; } catch (e) { return; }
    if (!n) return;
    var box = li.querySelector('.mod-prog'), bar = li.querySelector('.mod-bar');
    for (var i = 0; i < total; i++) { var s = document.createElement('i'); if (i < n) s.className = 'done'; bar.appendChild(s); }
    li.querySelector('.mod-prog-t').textContent = Math.min(n, total) + ' de ' + total + ' entendidas';
    box.hidden = false;
  });
</script>
</BaseLayout>
