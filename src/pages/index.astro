---
// Home: índice dos módulos, um por linha, na ordem da história (cada módulo é o próximo problema da loja).
// O progresso de cada linha vem do localStorage que o modo foco grava (sdl-<módulo>:done).
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url.js';

interface Mod { slug?: string; title: string; lessons?: number; text: string; poster?: string; alt?: string }
const modules: Mod[] = [
  { slug: 'protocolos-de-rede', title: 'Protocolos de Rede', lessons: 9, poster: 'labs/protocolos-de-rede/osi-3d-previa.webp', alt: 'Prévia da figura 3D do modelo OSI',
    text: 'OSI e HTTP em figuras 3D, IP, TCP e UDP, TLS, DNS, DHCP e tempo de resposta. Com quiz de 76 perguntas.' },
  { slug: 'storage-raid-io', title: 'Storage, RAID e I/O', lessons: 13, poster: 'labs/storage-raid-io/raid-3d-previa.webp', alt: 'Prévia da figura 3D de RAID',
    text: 'IOPS e throughput, DAS, NAS, block, file e object storage, e RAID 0, 1, 5, 6 e 10 em figuras 3D. Com calculadoras e quiz de 66 perguntas.' },
  { slug: 'cap-acid-base', title: 'Teorema CAP, ACID e BASE', lessons: 7, poster: 'labs/cap-acid-base/cap-3d-previa.webp', alt: 'Prévia da figura 3D do teorema CAP',
    text: 'Consistência, disponibilidade e partição, transações ACID, consistência eventual e PACELC, com um simulador de níveis de isolamento. Com quiz de 52 perguntas.' },
  { slug: 'databases', title: 'Databases, Modelos de Dados e Indexação', lessons: 15, poster: 'labs/databases/indices-3d-previa.webp', alt: 'Prévia da figura 3D de índices',
    text: 'Tipos de banco, níveis de consistência, os seis modelos de dados, páginas, LSM-Tree, B-Tree, hash e índice invertido, com calculadoras e simuladores. Com quiz de 61 perguntas.' },
  { slug: 'cache', title: 'Estratégias de Cache', lessons: 7, poster: 'labs/cache/cache-3d-previa.webp', alt: 'Prévia da figura 3D de cache',
    text: 'Hit e miss, TTL, evicção (LRU, LFU e FIFO), hit rate, hashmap e Redis, cache-aside, write-through, write-behind e CDN, com um proxy em Go lido linha a linha. Com quiz de 46 perguntas.' },
  { title: 'Em breve', text: 'O módulo 6 entra aqui.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="SDLabs" description="Laboratórios visuais e interativos de System Design.">
<style is:global>
.home{max-width:var(--page);margin:0 auto;padding:18px var(--gutter) var(--s-8)}
.home-head{padding:var(--s-7) 0 var(--s-6);border-bottom:var(--hair) solid var(--line-strong);position:relative}
.home-head::after{content:"";position:absolute;left:0;bottom:-1px;width:64px;height:var(--stroke);background:var(--accent-fill);box-shadow:var(--glow)}
.home-head h1 .lit{width:.16em;height:.16em;margin-right:.08em;vertical-align:.62em}
.home-head h1{margin:0 0 var(--s-4);font-size:clamp(40px,11vw,76px);font-weight:800;line-height:1;letter-spacing:-.035em}
.home-head .lead{margin:0 0 var(--s-3);max-width:34ch;font-size:clamp(20px,4.6vw,24px);line-height:1.4;color:var(--ink-hi)}
.home-head .story{margin:0;max-width:56ch;color:var(--muted)}

/* índice: uma linha por módulo */
.mods{list-style:none;margin:0;padding:0;counter-reset:m}
.mod{border-bottom:var(--hair) solid var(--line)}
.mod-link{display:grid;grid-template-columns:44px 1fr;gap:var(--s-2) var(--s-4);padding:var(--s-5) 0;color:var(--ink);text-decoration:none;position:relative}
.mod-n{font:700 15px/1.7 var(--mono);color:var(--faint);font-variant-numeric:tabular-nums;transition:color var(--dur-2)}
.mod-body{min-width:0}
.mod h2{margin:0 0 var(--s-2);font-size:clamp(22px,5.4vw,28px);font-weight:800;line-height:1.15;letter-spacing:-.015em;transition:color var(--dur-2)}
.mod p{margin:0;max-width:56ch;color:var(--muted);font-size:16px;line-height:1.55}
.mod-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px var(--s-4);margin-top:var(--s-3)}
.mod-meta .label{display:inline-flex;align-items:center;gap:var(--s-2)}
.mod-prog{color:var(--ok)}
.mod-prog[hidden]{display:none}
.mod-bar{display:flex;gap:2px;width:min(180px,40vw)}
.mod-bar i{flex:1;height:4px;border-radius:1px;background:var(--line-strong);opacity:.55}
.mod-bar i.done{background:var(--ok);opacity:1}
.mod-fig{display:none}
a.mod-link:hover h2,a.mod-link:focus-visible h2{color:var(--accent-ink)}
a.mod-link:hover .mod-n,a.mod-link:focus-visible .mod-n{color:var(--accent-ink)}
a.mod-link:focus-visible{outline:2px solid var(--accent-fill);outline-offset:4px;border-radius:var(--r-2)}
.mod.soon h2,.mod.soon .mod-n{color:var(--faint)}
@media (min-width:760px){
  .mod-link{grid-template-columns:64px 1fr 220px;align-items:start}
  .mod-n{font-size:18px;line-height:1.5}
  .mod-fig{display:block;position:relative;border:var(--hair) solid var(--line);border-radius:var(--r-2);overflow:hidden;background:var(--plate);aspect-ratio:8/5;transition:border-color var(--dur-2),box-shadow var(--dur-3) var(--ease-out)}
  .mod-fig img{display:block;width:100%;height:100%;object-fit:cover;opacity:.82;transition:opacity var(--dur-3) var(--ease-out)}
  a.mod-link:hover .mod-fig,a.mod-link:focus-visible .mod-fig{border-color:var(--accent-ink);box-shadow:0 0 0 1px var(--accent-ink),0 0 30px -10px rgba(255,157,60,.7)}
  a.mod-link:hover .mod-fig img,a.mod-link:focus-visible .mod-fig img{opacity:1}
}
.home-foot{margin-top:var(--s-7);padding-top:var(--s-5);border-top:var(--hair) solid var(--line);display:grid;gap:var(--s-3);font:13px/1.6 var(--mono);color:var(--muted)}
.home-foot p{margin:0;max-width:72ch}
.home-foot a{color:var(--ink)}
</style>
<main class="home">
  <header class="home-head">
    <h1><i class="lit" aria-hidden="true"></i>SDLabs</h1>
    <p class="lead">Laboratórios de System Design para mexer e não esquecer mais.</p>
    <p class="story">A mesma história do começo ao fim: a Lena, de Recife, compra um gato de pelúcia na loja, e cada módulo é o próximo problema que essa loja enfrenta ao crescer.</p>
  </header>
  <ol class="mods">
    {modules.map((m, i) => m.slug ? (
      <li class="mod" data-mod={m.slug} data-total={m.lessons}>
        <a class="mod-link" href={withBase(`labs/${m.slug}/`)}>
          <span class="mod-n" aria-hidden="true">{pad(i + 1)}</span>
          <div class="mod-body">
            <h2>{m.title}</h2>
            <p>{m.text}</p>
            <div class="mod-meta">
              <span class="label">Módulo {i + 1} · {m.lessons} aulas</span>
              <span class="label mod-prog" hidden><span class="mod-bar" aria-hidden="true"></span><span class="mod-prog-t"></span></span>
            </div>
          </div>
          <div class="mod-fig" aria-hidden="true"><img src={withBase(m.poster!)} alt="" width="640" height="560" loading="lazy" /></div>
        </a>
      </li>
    ) : (
      <li class="mod soon" aria-disabled="true">
        <div class="mod-link">
          <span class="mod-n" aria-hidden="true">{pad(i + 1)}</span>
          <div class="mod-body"><h2>{m.title}</h2><p>{m.text}</p></div>
        </div>
      </li>
    ))}
  </ol>
  <footer class="home-foot">
    <p>Notas pessoais de estudo, escritas com minhas palavras. Fonte: artigos públicos de Matheus Fidelis em <a href="https://fidelissauro.dev">fidelissauro.dev</a>. Sem vínculo com o autor ou com qualquer curso.</p>
    <p><a href={withBase('sistema-de-design/')}>Sistema de design do site</a></p>
  </footer>
</main>
<script is:inline>
  // progresso salvo pelo modo foco de cada módulo: "3 de 9 entendidas" + a régua
  document.querySelectorAll('.mod[data-mod]').forEach(function (li) {
    var n = 0, total = +li.dataset.total;
    try { n = (JSON.parse(localStorage.getItem('sdl-' + li.dataset.mod + ':done') || '[]') || []).length; } catch (e) { return; }
    if (!n) return;
    var box = li.querySelector('.mod-prog'), bar = li.querySelector('.mod-bar');
    for (var i = 0; i < total; i++) { var s = document.createElement('i'); if (i < n) s.className = 'done'; bar.appendChild(s); }
    li.querySelector('.mod-prog-t').textContent = Math.min(n, total) + ' de ' + total + ' entendidas';
    box.hidden = false;
  });
</script>
</BaseLayout>
