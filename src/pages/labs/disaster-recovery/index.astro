---
// Módulo Single Point of Failure e Disaster Recovery: as 5 aulas de src/content/disaster-recovery/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/disaster-recovery.css';

const entries = (await getCollection('disaster-recovery')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/disaster-recovery/quiz/');
---
<ModuleLayout
  title="Single Point of Failure e Disaster Recovery · SDLabs"
  description="A região de São Paulo some às 20:40 da Black Friday: o que é um ponto único de falha, como achar os que ninguém vê, redundância ativa e passiva, failover e split brain, as estratégias de Disaster Recovery e as métricas MTTD, MTTR, MTBF, RTO e RPO, com os números da loja, widgets e quiz."
  module="disaster-recovery"
  heading="Single Point of Failure e Disaster Recovery"
  lead={'O módulo 26 deixou a loja em quatro células, e a pergunta no ar: e se não cair uma célula, e sim a região de São Paulo inteira? O que é um ponto único de falha, como achar os que ninguém vê, como duplicar sem pagar o que não precisa, o que fazer num desastre e como medir se a recuperação melhora.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/disaster-recovery/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
