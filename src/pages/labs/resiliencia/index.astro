---
// Módulo Resiliência: as 13 aulas de src/content/resiliencia/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/resiliencia.css';

const entries = (await getCollection('resiliencia')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/resiliencia/quiz/');
---
<ModuleLayout
  title="Patterns de Resiliência · SDLabs"
  description="Continuar vendendo quando uma peça falha: disponibilidade e orçamento de erro, blast radius, healthchecks, idempotência, timeouts, retry com backoff e jitter, circuit breaker, fallback, degradação, backpressure, camada de dados, bulkheads e shuffle sharding, com os números do PSP em 8 s, widgets e quiz."
  module="resiliencia"
  heading="Patterns de Resiliência"
  lead={'Às 20:20 da Black Friday o PSP passa a responder em 8 s e o pool de 50 conexões do pagamentos esgota em 1,67 s. Como continuar vendendo, ou falhar pequeno e rápido, quando uma peça ruim aparece, sem uma dependência lenta derrubar a loja inteira.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/resiliencia/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
