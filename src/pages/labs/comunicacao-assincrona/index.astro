---
// Módulo Comunicação Assíncrona: as 10 aulas de src/content/comunicacao-assincrona/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/comunicacao-assincrona.css';

const entries = (await getCollection('comunicacao-assincrona')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/comunicacao-assincrona/quiz/');
---
<ModuleLayout
  title="Comunicação Assíncrona: Mensageria, Eventos e Streaming · SDLabs"
  description="Mensagens, comandos, eventos e documentos, filas, DLQ, streaming, Kafka (tópicos, partições, grupos e replicação), MQTT e AMQP com RabbitMQ, com widgets e quiz."
  module="comunicacao-assincrona"
  heading="Comunicação Assíncrona: Mensageria, Eventos e Streaming"
  lead="O pagamento da Lena precisa avisar o estoque, as entregas e as notificações. Como avisar sem esperar, sem perder o aviso e sem o produtor saber quem escuta, e qual protocolo serve a cada trecho: Kafka, MQTT ou AMQP."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/comunicacao-assincrona/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
