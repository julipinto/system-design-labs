---
// Módulo Protocolos de Rede: as 9 aulas de src/content/protocolos-de-rede/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/protocolos-de-rede.css';

const entries = (await getCollection('protocolos-de-rede')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/protocolos-de-rede/quiz/');
---
<ModuleLayout
  title="Protocolos de Rede · SDLabs"
  description="Protocolos de rede: OSI, IP, TCP/UDP, TLS, DNS, DHCP, HTTP e tempo de resposta, com laboratórios interativos."
  module="protocolos-de-rede"
  heading="Protocolos de Rede"
  lead="Protocolos de rede numa página só, com laboratórios que você mexe para ver acontecer."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/protocolos-de-rede/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
