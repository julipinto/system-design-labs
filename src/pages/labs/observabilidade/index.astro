---
// Módulo Observabilidade e Monitoramento: as 10 aulas de src/content/observabilidade/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/observabilidade.css';

const entries = (await getCollection('observabilidade')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/observabilidade/quiz/');
---
<ModuleLayout
  title="Observabilidade e Monitoramento · SDLabs"
  description="Ver o que a loja está fazendo, pedido por pedido: confiabilidade, monitoramento e observabilidade, métricas, logs e traces do pedido 1063, alertas e APM, SLI, SLO, SLA e orçamento de erro, e os métodos USE, RED e os quatro sinais de ouro, com as contas feitas, widgets e quiz."
  module="observabilidade"
  heading="Observabilidade e Monitoramento"
  lead={'A Lena esperou 1,9 s e o painel estava verde. Como enxergar o que acontece dentro da loja, pedido por pedido: confiabilidade, os três sinais, quando acordar alguém, quanto erro é aceitável e três atalhos (USE, RED e os quatro sinais) para saber onde olhar.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/observabilidade/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
