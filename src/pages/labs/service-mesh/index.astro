---
// Módulo Service Mesh: as 6 aulas de src/content/service-mesh/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/service-mesh.css';

const entries = (await getCollection('service-mesh')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/service-mesh/quiz/');
---
<ModuleLayout
  title="Service Mesh · SDLabs"
  description="Service mesh: retry, timeout, mTLS, autorização e telemetria na rede em vez de no código, control plane e data plane, sidecar, proxyless, eBPF e ambient, com laboratórios interativos."
  module="service-mesh"
  heading="Service Mesh"
  lead="Dentro da loja, 6 serviços em 3 linguagens se chamam o tempo todo, e cada time escreveu retry, timeout, TLS e métrica do seu jeito. Como tirar isso do código, pôr na rede uma vez só e saber quando a malha compensa."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/service-mesh/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
