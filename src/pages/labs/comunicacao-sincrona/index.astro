---
// Módulo Comunicação Síncrona: as 8 aulas de src/content/comunicacao-sincrona/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/comunicacao-sincrona.css';

const entries = (await getCollection('comunicacao-sincrona')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/comunicacao-sincrona/quiz/');
---
<ModuleLayout
  title="Comunicação Síncrona · SDLabs"
  description="REST, webhooks, short e long polling, RPC, gRPC e Protobuf, WebSocket e GraphQL: quando um serviço chama outro e espera, em que formato, por qual protocolo e como o outro lado avisa de volta, com bytes reais, calculadoras e quiz."
  module="comunicacao-sincrona"
  heading="Comunicação Síncrona"
  lead="O Davi quer a caneca azul e paga com Pix num PSP de terceiros. O pedidos chama o pagamentos, que chama o PSP, e a tela do Davi precisa saber quando o dinheiro entrou. Em que formato e por qual protocolo uma chamada espera, e como o outro lado avisa de volta."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/comunicacao-sincrona/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
