---
// Módulo Saga Pattern: as 10 aulas de src/content/saga/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/saga.css';

const entries = (await getCollection('saga')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/saga/quiz/');
---
<ModuleLayout
  title="Saga Pattern · SDLabs"
  description="Fazer um pedido que atravessa vários serviços terminar inteiro ou ser desfeito sem transação distribuída: compensações, coreografia e orquestração, máquina de estados, log de saga, escrita dupla e o laboratório do autor lido, com o pedido 1057 do Davi, widgets e quiz."
  module="saga"
  heading="Saga Pattern"
  lead="Um pedido passa por pedidos, pagamentos, estoque e entregas, cada um com o seu banco. Como fazer a operação terminar inteira ou ser desfeita, sem transação distribuída, sem deixar o Davi com dinheiro cobrado e pedido que não existe."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/saga/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
