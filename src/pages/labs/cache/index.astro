---
// Módulo Estratégias de Cache: as 7 aulas de src/content/cache/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/cache.css';

const entries = (await getCollection('cache')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/cache/quiz/');
---
<ModuleLayout
  title="Estratégias de Cache · SDLabs"
  description="Estratégias de cache: hit e miss, TTL, evicção LRU, LFU e FIFO, hit rate, hashmap e Redis, cache-aside, write-through, write-behind e CDN, com laboratórios interativos."
  module="cache"
  heading="Estratégias de Cache"
  lead="A página do gato de pelúcia ficou lenta porque todo mundo abre. Como a loja guarda uma cópia perto de quem pergunta, por quanto tempo ela pode ficar velha e o que acontece quando algo cai."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/cache/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
