---
// Módulo Testes de Carga e Estresse: as 11 aulas de src/content/testes-de-carga/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/testes-de-carga.css';

const entries = (await getCollection('testes-de-carga')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/testes-de-carga/quiz/');
---
<ModuleLayout
  title="Testes de Carga e Estresse · SDLabs"
  description="Refutar o plano da Black Friday com um teste: carga × estresse, smoke, carga média, estresse, spike e breakpoint com o k6 contra um simulador do checkout, modelo aberto × fechado, metas e percentis, pré-teste e relatório, com os números medidos, widgets e quiz."
  module="testes-de-carga"
  heading="Testes de Carga e Estresse"
  lead={'O plano do módulo 23 diz que o checkout aguenta 300 pedidos por segundo, e ninguém mediu. Como refutar essa conta com um teste, sem derrubar a produção: que pergunta fazer, como injetar a carga sem enganar a si mesmo, onde está o ponto de quebra e o que o teste ainda não mostra.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/testes-de-carga/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
