---
// Módulo Capacity Planning: as 9 aulas de src/content/capacity-planning/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/capacity-planning.css';

const entries = (await getCollection('capacity-planning')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/capacity-planning/quiz/');
---
<ModuleLayout
  title="Capacity Planning · SDLabs"
  description="A Black Friday de 2027 aguenta? Teoria das filas, Lei de Little e o ponto saudável, curva do joelho, modelagem de carga, perfis de tráfego, projeção de crescimento, capacidade end to end e a ficha de limites, com os números do checkout da loja, widgets e quiz."
  module="capacity-planning"
  heading="Capacity Planning"
  lead={'O comercial pergunta toda primavera se a Black Friday do ano que vem aguenta. Como transformar o que foi medido em 2026 (640 req/s no catálogo, 40 pedidos/s de capacidade no pagamentos) em um plano para 26/11/2027: quanto cada serviço precisa ter, em que ordem os elos quebram, quanto custa e o que ainda não se sabe.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/capacity-planning/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
