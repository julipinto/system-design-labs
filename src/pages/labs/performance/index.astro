---
// Módulo Performance, Capacidade e Escalabilidade: as 6 aulas de src/content/performance/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/performance.css';

const entries = (await getCollection('performance')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/performance/quiz/');
---
<ModuleLayout
  title="Performance, Capacidade e Escalabilidade · SDLabs"
  description="Medir (tempo de resposta, quatro sinais, percentis), limitar (capacidade, joelho da curva, gargalo) e crescer (vertical, horizontal e a fórmula do HPA), com os números da Black Friday da loja, widgets e quiz."
  module="performance"
  heading="Performance, Capacidade e Escalabilidade"
  lead="A Black Friday mostrou um catálogo que respondeu em 2 s para parte dos clientes, e ninguém sabia quanto a loja aguenta. Como medir direito, descobrir o limite de cada elo e decidir quanto adicionar e quando."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/performance/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
