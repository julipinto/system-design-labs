---
// Módulo CQRS: as 10 aulas de src/content/cqrs/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/cqrs.css';

const entries = (await getCollection('cqrs')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/cqrs/quiz/');
---
<ModuleLayout
  title="CQRS · SDLabs"
  description="Um modelo para escrever e outro para ler: comandos e consultas, view materializada, réplicas de leitura, consistência eventual, SQL e NoSQL, modelos distribuídos, escrita dupla, CDC e outbox, com os números da Black Friday da loja, widgets e quiz."
  module="cqrs"
  heading="CQRS"
  lead={'A tela "meus pedidos" da Lena lê da mesma tabela em que o checkout escreve e junta quatro serviços para aparecer. Como ter um modelo para escrever e outro para ler, e mantê-los em sincronia sem perder pedido nem mostrar fantasma.'}
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/cqrs/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
