---
// Módulo Microsserviços, Monolitos e Domínios: as 8 aulas de src/content/microsservicos/, na ordem do campo `order`.
import { getCollection, render } from 'astro:content';
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import Lesson from '../../../components/Lesson.astro';
import { withBase } from '../../../lib/url.js';
import '../../../styles/microsservicos.css';

const entries = (await getCollection('microsservicos')).sort((a, b) => a.data.order - b.data.order);
const lessons = await Promise.all(entries.map(async (e) => ({ id: e.id, data: e.data, Content: (await render(e)).Content })));
const quiz = withBase('labs/microsservicos/quiz/');
---
<ModuleLayout
  title="Microsserviços, Monolitos e Domínios · SDLabs"
  description="Quando e como partir um monolito em microsserviços: vizinho barulhento, raio de explosão, banco por serviço, DDD, Lei de Conway e eventos de domínio, com laboratórios interativos."
  module="microsservicos"
  heading="Microsserviços, Monolitos e Domínios"
  lead="A loja rápida ainda é um programa só, e ele já atrapalha os próprios times. Quando partir, onde cortar e o que isso custa: monolito, microsserviços, domínios e o pedido 1047 passando por tudo."
  lessons={lessons.map((l) => ({ id: l.id, title: l.data.title }))}
  quizHref={quiz}
>
  <Fragment slot="head">
    <script>
      import '../../../scripts/microsservicos/widgets.js';
    </script>
  </Fragment>
  {lessons.map(({ id, data, Content }, i) => (
    <Lesson
      id={id} n={i + 1} total={lessons.length} title={data.title} min={data.min}
      prev={lessons[i - 1]?.id} next={lessons[i + 1]?.id}
      final={{ href: quiz, label: 'Teste o que aprendeu: quiz →' }}
    >
      <Content />
    </Lesson>
  ))}
</ModuleLayout>
