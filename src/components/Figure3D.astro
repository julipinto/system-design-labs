---
// Figura 3D (skill iso-glow) embutida numa aula. A página da figura é gerada no build (npm run build:3d)
// em public/<path>/. Desktop: iframe que carrega quando a aula aparece. Celular: prévia + botão de tela cheia,
// para o dedo não ficar preso girando a cena em vez de rolar a página.
// Moldura: prancha escura nos dois temas (a cena é escura), traço fino; com o foco, a borda passa a sódio, sem halo.
import { t as tr } from '../lib/i18n.js';
const T = tr(Astro.url);
import { withBase } from '../lib/url.js';
interface Props { path: string; poster: string; alt: string; title: string; hint?: string; }
const { path, poster, alt, title, hint = T.figHint } = Astro.props;
const src = withBase(path);
---
<figure class="f3d-wrap" data-src={`${src}${src.includes('?') ? '&' : '?'}embed=1`} data-title={title}>
  <div class="f3d-plate">
    <a class="f3d-poster" href={src}>
      <img src={withBase(poster)} alt={alt} width="640" height="560" loading="lazy" />
      <span class="f3d-cta"><i aria-hidden="true"></i>{T.figOpen}</span>
    </a>
  </div>
  <figcaption class="f3d-bar" data-no-gl>
    <span class="f3d-tag">{T.fig}</span>
    <span class="f3d-hint">{hint}</span>
    <a class="f3d-full" href={src}>{T.figFull}<i aria-hidden="true"></i></a>
  </figcaption>
</figure>
<script is:inline>
  (function () {
    const wrap = document.currentScript.previousElementSibling;
    if (!wrap || !matchMedia('(min-width: 720px)').matches) return;
    const mount = () => { if (wrap.querySelector('iframe')) return;
      const f = document.createElement('iframe'); f.className = 'f3d-frame'; f.src = wrap.dataset.src; f.loading = 'lazy';
      f.title = wrap.dataset.title; f.allow = 'fullscreen';
      // com o mouse em cima, a figura recebe o foco: as setas do teclado passam a funcionar sem precisar clicar
      f.addEventListener('pointerenter', () => { try { f.focus({ preventScroll: true }); } catch (e) {} });
      wrap.querySelector('.f3d-poster').replaceWith(f); };
    if ('IntersectionObserver' in window) new IntersectionObserver((es, io) => { if (es.some(e => e.isIntersecting)) { mount(); io.disconnect(); } }, { rootMargin: '300px' }).observe(wrap);
    else mount();
  })();
</script>
<style is:global>
  .f3d-wrap{max-width:var(--page);margin:var(--s-5) 0 var(--s-6);padding:0}
  .f3d-plate{position:relative}
  .f3d-frame,.f3d-poster{display:block;width:100%;border:var(--hair) solid var(--line);border-radius:var(--r-3);background:var(--plate);transition:border-color var(--dur-2),box-shadow var(--dur-3) var(--ease-out)}
  .f3d-frame{height:min(760px,86vh)}
  .f3d-wrap:hover .f3d-frame{border-color:var(--line-strong)}
  .f3d-wrap:focus-within .f3d-frame{border-color:var(--accent-ink)}
  .f3d-poster{position:relative;overflow:hidden;text-decoration:none}
  .f3d-poster img{display:block;width:100%;height:auto}
  .f3d-poster:focus-visible{outline:2px solid var(--accent-fill);outline-offset:3px}
  .f3d-cta{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:inline-flex;align-items:center;gap:10px;padding:14px 22px;min-height:52px;border-radius:var(--r-2);background:var(--accent-fill);color:var(--on-accent);font:600 16px/1.2 var(--sans);white-space:nowrap;box-shadow:0 6px 16px -4px rgba(0,0,0,.5)}
  .f3d-cta i{width:0;height:0;border-left:11px solid currentColor;border-top:7px solid transparent;border-bottom:7px solid transparent}
  .f3d-bar{display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;margin-top:10px;font:500 14px/1.4 var(--sans);color:var(--muted)}
  .f3d-tag{font-weight:600;color:var(--ink-hi)}
  .f3d-hint{flex:1 1 280px;min-width:0;font-weight:400;letter-spacing:0}
  .f3d-full{display:inline-flex;align-items:center;gap:6px;min-height:44px;color:var(--ink-hi);font-weight:600;text-decoration:none}
  .f3d-full i{width:8px;height:8px;border-top:var(--stroke) solid currentColor;border-right:var(--stroke) solid currentColor}
  .f3d-full:hover{color:var(--accent-ink)}
  /* celular: só sobra o rótulo; ele entra no canto da prancha, como o "Fig N" das figuras, em vez de ficar solto embaixo */
  @media (max-width:719px){
    .f3d-wrap{position:relative}
    .f3d-bar{position:absolute;top:var(--s-3);left:var(--s-3);z-index:2;margin:0;pointer-events:none}
    .f3d-tag{color:var(--on-plate)}
    .f3d-hint,.f3d-full{display:none}
  }
</style>
