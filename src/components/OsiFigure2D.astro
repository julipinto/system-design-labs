---
// Figura OSI 2D (skill anatomy). Gerada em tempo de build por buildOsiFigure(): css, html e script entram prontos.
import { buildOsiFigure } from '../figures/osi/osi-figure.mjs';
const fig = buildOsiFigure();
const css = `.sdl-content .lesson>div.osi-wrap{max-width:960px;margin:22px 0 30px}\n${fig.css}`;
const script = fig.script.replace(/<\/(script)/gi, '<\\/$1');
---
<style is:inline set:html={css}></style>
<div class="osi-wrap" set:html={fig.html}></div>
<script is:inline type="module" set:html={script}></script>
