---
// Login opcional para levar o progresso entre aparelhos: "Entrar" discreto no topo e um modal (<dialog>).
// Sem JS, o botão fica escondido (o progresso segue no navegador). Quem liga tudo: public/shared/sync.js.
// Os textos de estado vão em data-* para o script não precisar saber a língua.
import { t } from '../lib/i18n.js';
import '../styles/account.css';
const A = t(Astro.url).acct;
---
<button type="button" class="acct-btn" data-acct hidden aria-haspopup="dialog" aria-controls="acct-dlg" aria-label={A.btnAria} data-aria-on={A.btnAriaOn('{e}')}>
  <span class="acct-in">{A.signIn}</span>
  <span class="acct-av" aria-hidden="true" hidden></span>
</button>
<dialog id="acct-dlg" class="acct-dlg" aria-labelledby="acct-h"
  data-syncing={A.syncing} data-synced={A.synced} data-never={A.never} data-offline={A.offline} data-error={A.error}
  data-title-out={A.title} data-title-on={A.titleOn}>
  <div class="acct-head">
    <h2 id="acct-h">{A.title}</h2>
    <button type="button" class="acct-x" data-acct-close aria-label={A.close}><span aria-hidden="true">×</span></button>
  </div>
  <div class="acct-out">
    <p class="acct-what">{A.what}</p>
    <button type="button" class="acct-google" data-acct-google>
      <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/></svg>
      <span>{A.google}</span>
    </button>
    <p class="acct-err" role="alert" hidden></p>
    <p class="acct-small">{A.privacy}</p>
    <p class="acct-small">{A.local}</p>
  </div>
  <div class="acct-on" hidden>
    <p class="acct-email"></p>
    <p class="acct-status" aria-live="polite"></p>
    <button type="button" class="acct-out-btn" data-acct-out>{A.signOut}</button>
    <p class="acct-small">{A.outNote}</p>
  </div>
</dialog>
