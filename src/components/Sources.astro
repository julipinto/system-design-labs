---
// Lista "Fontes". Item com href vira link externo; sem href, texto puro.
import { t as tr } from '../lib/i18n.js';
const T = tr(Astro.url);
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="sources"><h4>{T.sources}</h4><ul>{items.map((s) => <li>{s.href ? <a href={s.href} target="_blank" rel="noopener"><span>{s.label}</span></a> : s.label}</li>)}</ul></div>
