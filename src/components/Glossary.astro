---
// Glossário completo do módulo: <details> no fim, em ordem alfabética, com link para a aula.
// Também entrega os dados (JSON) para o script das fichas tocáveis (src/scripts/glossary.js).
interface Term { term: string; aliases: string[]; short: string; layer?: number; lesson: string }
interface Props { terms: Term[]; lessons: { id: string; title: string }[] }
const { terms, lessons } = Astro.props;
const n = (id: string) => lessons.findIndex((l) => l.id === id) + 1;
const sorted = [...terms].sort((a, b) => a.term.localeCompare(b.term, 'pt', { sensitivity: 'base' }));
const data = JSON.stringify(terms.map((t) => ({ ...t, n: n(t.lesson) }))).replace(/</g, '\\u003c');
---
<details class="gl-all" id="glossario">
  <summary>Glossário ({terms.length} termos)</summary>
  <p class="gl-all-hint">Os termos sublinhados nas aulas também abrem aqui. Toque em "Aula" para ir ao lugar onde o termo é explicado.</p>
  <dl class="gl-list">
    {sorted.map((t) => (
      <div class="gl-item">
        <dt>{t.term}{t.layer ? <span class="gl-layer">Camada {t.layer}</span> : null}</dt>
        <dd>{t.short} <a href={`#${t.lesson}`} data-gl-lesson={t.lesson}>Aula {n(t.lesson)}<i class="ico ico-next" aria-hidden="true"></i></a></dd>
      </div>
    ))}
  </dl>
</details>
<script type="application/json" id="gl-data" set:html={data}></script>
